[Unit]
Description=Halt Immortal services in order at system shutdown
# Units stop in the reverse of their start order. Starting before the manager
# makes this unit stop after it: the manager must be gone before services are
# halted, or it would start them again. Starting after the network and the
# file systems makes it stop while services can still reach them.
Before=immortaldir.service
After=network.target remote-fs.target local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# Services are halted one after another. --timeout is how long each may take
# to stop, including its stop hook, and every service also costs up to five
# seconds to probe first, so the services together need at most
# N * (timeout + 5 s). Raise TimeoutStopSec to cover that for your N, or
# lower --timeout; a service whose hook is allowed longer needs a larger one.
ExecStop=/usr/local/bin/immortalctl --runtime-dir /run/immortal --timeout 30 halt --all
# Halting with no service present reports "not found"; that is not a failure.
SuccessExitStatus=66
# Bounds the whole command; systemd releases the ordering and continues the
# shutdown when it expires. 180 s covers five services that each use their
# whole budget.
TimeoutStopSec=180s

[Install]
WantedBy=multi-user.target
