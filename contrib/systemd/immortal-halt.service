[Unit]
Description=Halt Immortal services in order at system shutdown
# Units stop in the reverse of their start order. Starting before the manager
# makes this unit stop after it: the manager must be gone before services are
# halted, or it would start them again. Starting after the network and the
# file systems makes it stop while services can still reach them.
Before=immortaldir.service
After=network.target remote-fs.target local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# Services are halted one after another, and --timeout is how long each may
# take to stop, including its stop hook; the default of 30 seconds is too
# short for a service whose hook and lifetime wait are allowed longer.
ExecStop=/usr/local/bin/immortalctl --runtime-dir /run/immortal --timeout 100 halt --all
# Halting with no service present reports "not found"; that is not a failure.
SuccessExitStatus=66
# Bounds the whole command, so it must exceed the graceful stops of all
# services together; systemd releases the ordering when it expires.
TimeoutStopSec=120s

[Install]
WantedBy=multi-user.target
