[Unit]
Description=Immortal service-definition reconciler
After=local-fs.target
# Optional companion that halts every service in order at system shutdown.
# It stops after this unit, and a restart of this unit leaves it alone.
Wants=immortal-halt.service
After=immortal-halt.service

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m 0755 /run/immortal
ExecStart=/usr/local/sbin/immortaldir --runtime-dir /run/immortal --supervisor-binary /usr/local/sbin/immortal /etc/immortal
Restart=on-failure
RestartSec=1s
TimeoutStopSec=30s
# Supervisors intentionally outlive a manager restart; do not kill their cgroup.
KillMode=process

[Install]
WantedBy=multi-user.target
